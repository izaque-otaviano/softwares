# Copie para .env.local (não versionado) e ajuste.

# 'mock' (padrão): dados de exemplo no navegador, sem login. 'real': backend Resolv (login + sessão).
VITE_API_MODE=mock

# Origem do backend para as chamadas HTTP. Deixe VAZIO para usar o proxy do Vite (mesma origem: recomendado,
# evita CORS e problemas de cookie/CSRF). Ex. sem proxy: http://127.0.0.1:8000
VITE_API_URL=

# Alvo do proxy do Vite para /api e /ws (só o dev server lê). Padrão: http://127.0.0.1:8000
VITE_API_PROXY=http://127.0.0.1:8000
