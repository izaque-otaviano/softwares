+/** The section's glyph in a 42 px disc: dark on the idle panel, light grey inside the focused capsule. */
+@Composable
+private fun RailIconDisc(icon: OwnTVIcon, focused: Boolean, accentIcon: Boolean) {
+    val a = stageAccent
+    Box(
+        Modifier
+            .size(42.mpx)
+            .background(if (focused) a.onAccent.copy(alpha = 0.10f) else StageColors.Ink.copy(alpha = 0.10f), CircleShape),
+        contentAlignment = Alignment.Center,
+    ) {
+        val tint = when {
+            focused -> a.onAccent
+            accentIcon -> OwnTVTheme.colors.primary
+            else -> StageColors.NavText
+        }
+        OwnTVIcon(icon, tint, Modifier.size(22.mpx))
+    }
+}
+
+/**
+ * The open panel's header: avatar, profile name and the time. OK switches profile; a long press changes
+ * the avatar.
+ */
+@Composable
+private fun RailHeader(name: String, avatarId: Int, avatarPath: String, onSwitchProfile: () -> Unit, onPickAvatar: () -> Unit) {
+    val a = stageAccent
+    val initial = name.trim().take(1).uppercase().ifEmpty { "?" }
+    val time = rememberRailClock()
+    StageSurface(
+        onClick = onSwitchProfile,
+        onLongClick = onPickAvatar,
+        radius = 30.mpx,
+        modifier = Modifier.fillMaxWidth().padding(bottom = 10.mpx),
+        contentAlignment = Alignment.CenterStart,
+    ) { focused ->
+        Row(
+            Modifier.padding(start = 10.mpx, end = 16.mpx, top = 8.mpx, bottom = 8.mpx),
+            horizontalArrangement = Arrangement.spacedBy(14.mpx),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            RailAvatar(initial, size = 44, avatarId = avatarId, imagePath = avatarPath)
+            Text(
+                name, style = stageText(20, 600), color = if (focused) a.onAccent else StageColors.Text,
+                maxLines = 1, overflow = TextOverflow.Ellipsis, modifier = Modifier.weight(1f),
+            )
+            Text(time, style = stageText(19, 500), color = if (focused) a.onAccent.copy(alpha = 0.7f) else StageColors.Muted, maxLines = 1)
+        }
+    }
+}
+
+/** The time in the device's 12/24 h format, refreshed while the panel is open. */
+@Composable
+private fun rememberRailClock(): String {
+    val context = LocalContext.current
+    var now by remember { mutableStateOf(System.currentTimeMillis()) }
+    LaunchedEffect(Unit) {
+        while (true) {
+            now = System.currentTimeMillis()
+            delay(15_000)
+        }
+    }
+    return remember(now) { android.text.format.DateFormat.getTimeFormat(context).format(java.util.Date(now)) }
+}
