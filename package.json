{
  "name": "iconhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "test": "cd src-tauri && PATH=/opt/homebrew/opt/rustup/bin:$PATH cargo test --release",
    "dev": "PATH=/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH tauri dev",
    "build": "npm run icons && PATH=/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH tauri build",
    "build:mac": "npm run icons && PATH=/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:windows": "npm run icons && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 XWIN_ACCEPT_LICENSE=1 PATH=/opt/homebrew/opt/llvm/bin:/opt/homebrew/opt/lld/bin:/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/circle-flags": "^1.2.12",
    "@iconify-json/devicon": "^1.2.71",
    "@iconify-json/eva": "^1.2.3",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/feather": "^1.2.1",
    "@iconify-json/flagpack": "^1.2.8",
    "@iconify-json/fluent": "^1.2.60",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/iconoir": "^1.2.12",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/majesticons": "^1.2.5",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/noto": "^1.2.9",
    "@iconify-json/octicon": "^1.2.39",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/solar": "^1.2.13",
    "@iconify-json/tabler": "^1.2.42",
    "@iconify-json/twemoji": "^1.2.5",
    "@iconify-json/uil": "^1.2.3",
    "@tauri-apps/cli": "^2.12.2"
  }
}
